{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/codejam",
        "--user-data-dir=${env:TEMP}/codejam-extension-dev",
        "--disable-extensions",
        "${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/codejam/dist/**/*.js"
      ]
    },
    {
      "name": "Run Extension - Person 2",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/codejam/scripts/person2.cjs",
      "console": "internalConsole"
    }
  ],
  "compounds": [
    {
      "name": "CodeJam - Two People",
      "preLaunchTask": "CodeJam: compile",
      "configurations": [
        "Run Extension",
        "Run Extension - Person 2"
      ],
      "stopAll": false
    }
  ]
}
