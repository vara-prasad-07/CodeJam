{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/codejam",
        "--user-data-dir=${env:TEMP}/codejam-extension-dev",
        "--disable-extensions",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/codejam/dist/**/*.js"]
    },
    {
      "name": "Run Extension - Person 2",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/codejam",
        "--user-data-dir=${env:TEMP}/codejam-person-2-debug",
        "--disable-extensions",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/codejam/dist/**/*.js"]
    }
  ],
  "compounds": [
    {
      "name": "CodeJam - Two People",
      "preLaunchTask": "CodeJam: compile",
      "configurations": ["Run Extension", "Run Extension - Person 2"],
      "stopAll": true
    }
  ]
}
