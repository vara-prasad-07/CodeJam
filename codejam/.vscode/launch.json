{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--user-data-dir=${env:TEMP}/codejam-extension-dev",
        "--disable-extensions"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "${defaultBuildTask}"
    },
    {
      "name": "Run Extension - Person 2",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/person2.cjs",
      "console": "internalConsole"
    }
  ],
  "compounds": [
    {
      "name": "CodeJam - Two People",
      "configurations": [
        "Run Extension",
        "Run Extension - Person 2"
      ],
      "stopAll": false
    }
  ]
}
