{
  "name": "codejam-workspace",
  "displayName": "CodeJam Workspace",
  "description": "Repository-aware team chat, code discussions, searchable decisions, reviewed AI drafts, and audio huddles.",
  "version": "1.0.9",
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codejam",
          "title": "CodeJam",
          "icon": "media/codejam.svg"
        }
      ]
    },
    "views": {
      "codejam": [
        {
          "type": "webview",
          "id": "codejam.workspace",
          "name": "Workspace"
        }
      ]
    },
    "commands": [
      {
        "command": "codejam.open",
        "title": "CodeJam: Open Workspace"
      },
      {
        "command": "codejam.openPanel",
        "title": "CodeJam: Open Full View"
      },
      {
        "command": "codejam.resetSession",
        "title": "CodeJam: Reset Server Session"
      },
      {
        "command": "codejam.shareSelection",
        "title": "CodeJam: Share Selection with Team"
      },
      {
        "command": "codejam.selectMicrophone",
        "title": "CodeJam: Select Microphone"
      }
    ],
    "configuration": {
      "title": "CodeJam",
      "properties": {
        "codejam.apiUrl": {
          "type": "string",
          "default": "https://codejam-vdmp.onrender.com",
          "scope": "machine",
          "description": "CodeJam backend URL. Defaults to the hosted service; change this for a self-hosted or local backend."
        },
        "codejam.displayName": {
          "type": "string",
          "default": "Developer",
          "maxLength": 60,
          "scope": "machine",
          "description": "Your chat display name. For shared rooms, reset the server session after changing your name."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "codejam.shareSelection",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "navigation@20"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run test:base",
    "server": "node --env-file-if-exists=server/.env server/index.mjs",
    "test:server": "node --test server/*.test.mjs",
    "test:base": "npm run compile-tests && node --test tests/*.test.cjs server/*.test.mjs",
    "test:extension": "vscode-test",
    "test:nexconn": "npm run package && node --env-file=server/.env tests/live-nexconn.mjs",
    "test:person2": "node scripts/person2.cjs",
    "test:project": "npm run package && node --env-file=server/.env tests/live-project.mjs",
    "vsix": "vsce package --no-dependencies --out ../artifacts/ --baseContentUrl https://github.com/vara-prasad-07/CodeJam/blob/main/codejam --baseImagesUrl https://github.com/vara-prasad-07/CodeJam/raw/main/codejam",
    "set:publisher": "node scripts/set-publisher.cjs",
    "check:release": "node scripts/check-release.cjs",
    "build:recorder": "node scripts/build-recorder.cjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.146.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "jsdom": "^31.0.1",
    "npm-run-all": "^4.1.5",
    "path-browserify": "^1.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6",
    "@grpc/grpc-js": "^1.14.7"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "CodeJam reads local Git metadata and selected project files."
    }
  },
  "dependencies": {
    "@nexconn/call": "26.2.1",
    "@nexconn/chat": "26.2.0",
    "@nexconn/engine": "26.2.0",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1"
  },
  "publisher": "CodeJam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vara-prasad-07/CodeJam.git",
    "directory": "codejam"
  },
  "keywords": [
    "team chat",
    "collaboration",
    "code review",
    "git",
    "developer tools",
    "handoff",
    "nexconn"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#101116",
    "theme": "dark"
  },
  "author": {
    "name": "vara-prasad-07"
  },
  "homepage": "https://github.com/vara-prasad-07/CodeJam#readme",
  "bugs": {
    "url": "https://github.com/vara-prasad-07/CodeJam/issues"
  },
  "markdown": "github",
  "preview": true,
  "qna": "marketplace"
}
