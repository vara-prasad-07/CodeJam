# Required for Nexconn Chat. Use the same application/environment for both keys.
NEXCONN_APP_KEY=YOUR_DEVELOPMENT_APP_KEY
NEXCONN_APP_SECRET=YOUR_DEVELOPMENT_APP_SECRET
# Must match your app's data center: SG (Singapore), NA (North America), SA (Saudi Arabia)
NEXCONN_REGION=SG
PORT=3000
# Optional absolute path; defaults to server/.data/nexconn-rooms.json
# CODEJAM_DATA_FILE=C:/path/to/nexconn-rooms.json
