# FUTURE Supabase/AI configuration. The current server reads server/.env.
# Place Nexconn keys in server/.env using server/.env.example, not this file.
# These additional services are not implemented or needed for Nexconn Chat yet.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL=YOUR_AVAILABLE_MODEL_ID
