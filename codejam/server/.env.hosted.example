# Render backend uses Admin/IAM credentials. Lock Firestore rules after verifying deployment.
# See README before deploying. Keep real credentials private.
HOST=0.0.0.0
# Render supplies PORT automatically; do not copy your local PORT here.
CODEJAM_PUBLIC_URL=https://your-backend.example
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_REGION=SG
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
GEMINI_API_KEY=
CODEJAM_ALLOW_GUESTS=false

# Render Environment > Secret Files: firebase-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
